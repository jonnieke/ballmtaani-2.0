# Ballmtaani Environment Variables Template
# Copy this file to artifacts/ballmtaani/.env.local and fill in your real values.
# NEVER commit .env.local to git.

# Supabase (get from: https://supabase.com/dashboard → Settings → API)
VITE_SITE_URL=https://ballmtaani.com
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_KEY=your_supabase_anon_key_here

# Google Gemini AI (get from: https://aistudio.google.com/app/apikey)
VITE_GEMINI_API=your_gemini_api_key_here

# OpenAI for Mchambuzi Halisi primary analyst engine
# Production/serverless env name. Do not expose this in browser builds.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4.1-mini

# Optional local-only browser fallback while developing. Prefer OPENAI_API_KEY in production.
VITE_OPENAI_API_KEY=your_openai_api_key_here
VITE_OPENAI_MODEL=gpt-4.1-mini

# Serverless Gemini fallback for Mchambuzi
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Mchambuzi routing. Use gemini-first to spend Gemini credits while OpenAI remains fallback.
MCHAMBUZI_PROVIDER_ORDER=gemini-first
VITE_MCHAMBUZI_PROVIDER_ORDER=gemini-first

# API-Football (get from: https://dashboard.api-football.com)
API_FOOTBALL_KEY=your_api_football_key_here
VITE_API_FOOTBALL_KEY=your_api_football_key_here

# Google AdSense slots (from your AdSense ad unit setup)
VITE_ADSENSE_SLOT_HORIZONTAL=your_horizontal_slot_id_here
VITE_ADSENSE_SLOT_SQUARE=your_square_slot_id_here
