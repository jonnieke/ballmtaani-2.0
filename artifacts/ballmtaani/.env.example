# BallMtaani Environment Variables Template
# Copy to .env.local and fill in your values. NEVER commit .env.local to git.
#
# SECURITY NOTE: Only VITE_* variables are bundled into the browser.
# AI provider keys must NOT use the VITE_ prefix — they belong only in
# Vercel Dashboard → Settings → Environment Variables (server-side only).

# ── Site ──────────────────────────────────────────────────────────────────────
VITE_SITE_URL=https://ballmtaani.com

# ── Supabase (get from: supabase.com/dashboard → Settings → API) ─────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_KEY=your_supabase_anon_key_here
# Service role key — server-side only (settlement worker, bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ── Vertex AI via Workload Identity Federation (no keys — GCP credits) ────────
# Run scripts/setup-wif.sh first, then add the values it prints.
# No GOOGLE_SERVICE_ACCOUNT_JSON needed — WIF is keyless.
GCP_PROJECT_NUMBER=your_numeric_project_number
VERTEX_PROJECT_ID=ball-mtaani-496717
VERTEX_LOCATION=us-central1
VERTEX_MODEL=gemini-2.0-flash-001
VERTEX_SERVICE_ACCOUNT=ballmtaani-vertex@ball-mtaani-496717.iam.gserviceaccount.com
WORKLOAD_IDENTITY_POOL_ID=vercel-pool
WORKLOAD_IDENTITY_PROVIDER_ID=vercel-provider
# VERCEL_OIDC_TOKEN is auto-injected by Vercel — enable in Project Settings → Security
MCHAMBUZI_PROVIDER_ORDER=vertexai-first

# ── OpenAI — fallback if Vertex AI is unavailable ─────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4.1-mini

# ── Local dev only — never set in Vercel ──────────────────────────────────────
# Run: gcloud auth application-default login  (one-time setup)
# For quick overrides: LOCAL_GCP_ACCESS_TOKEN=$(gcloud auth print-access-token)
# LOCAL_GCP_ACCESS_TOKEN=

# ── API-Football (get from: dashboard.api-football.com) ──────────────────────
# VITE_ prefix safe here: it's a read-only data key, not an account credential
VITE_API_FOOTBALL_KEY=your_api_football_key_here

# ── Cron security ─────────────────────────────────────────────────────────────
# Set in Vercel Dashboard. Vercel sends this as Authorization: Bearer <value>
# to /api/settle-predictions on its cron schedule.
CRON_SECRET=generate_with_openssl_rand_hex_32

# ── Web Push notifications ────────────────────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
# Public key is safe to expose via VITE_ prefix (it's designed to be public)
VITE_VAPID_PUBLIC_KEY=your_vapid_public_key_here

# ── Google AdSense ────────────────────────────────────────────────────────────
VITE_ADSENSE_SLOT_HORIZONTAL=your_horizontal_slot_id_here
VITE_ADSENSE_SLOT_SQUARE=your_square_slot_id_here

# Oddspedia widget token (client-side widget config)
VITE_ODDSPEDIA_API_TOKEN=your_oddspedia_widget_token_here

# Production hardening flags
VITE_ENABLE_MOCK_AUTH=false
VITE_ENABLE_CONTENT_MOCKS=false
