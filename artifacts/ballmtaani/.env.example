# Ballmtaani Environment Variables Template
# Copy this file to artifacts/ballmtaani/.env.local and fill in your real values.
# NEVER commit .env.local to git.

# Supabase (get from: https://supabase.com/dashboard → Settings → API)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_KEY=your_supabase_anon_key_here

# Google Gemini AI (get from: https://aistudio.google.com/app/apikey)
VITE_GEMINI_API=your_gemini_api_key_here

# API-Football (get from: https://dashboard.api-football.com)
VITE_API_FOOTBALL_KEY=your_api_football_key_here

# Google AdSense slots (from your AdSense ad unit setup)
VITE_ADSENSE_SLOT_HORIZONTAL=your_horizontal_slot_id_here
VITE_ADSENSE_SLOT_SQUARE=your_square_slot_id_here
