{
  "framework": "vite",
  "rootDirectory": "artifacts/ballmtaani",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install --legacy-peer-deps",
  "crons": [
    {
      "path": "/api/settle-predictions",
      "schedule": "0 9 * * *"
    }
  ],
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
