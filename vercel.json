{
  "framework": "vite",
  "buildCommand": "cd artifacts/ballmtaani && npm run build",
  "outputDirectory": "artifacts/ballmtaani/dist",
  "installCommand": "cd artifacts/ballmtaani && npm install --legacy-peer-deps",
  "crons": [
    {
      "path": "/api/settle-predictions",
      "schedule": "0 9 * * *"
    }
  ],
  "redirects": [
    { "source": "/:path*", "destination": "https://ballmtaani.com/:path*", "has": [{ "type": "host", "value": "www.ballmtaani.com" }], "permanent": true }
  ],
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
